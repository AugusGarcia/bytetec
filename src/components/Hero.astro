---
import heroCpu from "../assets/hero-cpu.jpg";
---

<section
	class="relative overflow-hidden border-b border-line bg-bg"
	aria-labelledby="hero-title"
>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_70%_35%,rgba(180,255,57,0.07),transparent_60%)]"
		aria-hidden="true"
	>
	</div>

	<div class="container-page relative z-10 py-16 md:py-24">
		<div class="flex flex-col gap-6 md:w-1/2">
			<p
				data-hero
				class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase"
			>
				<span class="text-lime">●</span> SERVICIO TÉCNICO / HARDWARE · SOFTWARE
			</p>

			<h1
				id="hero-title"
				class="font-display text-6xl leading-[0.85] italic uppercase sm:text-7xl lg:text-[5.5rem]"
			>
				<span data-hero class="block">TU EQUIPO.</span>
				<span data-hero class="block">SU MÁXIMO</span>
				<span data-hero class="block text-lime"
					>POTENCIAL.<span class="caret" aria-hidden="true">_</span></span
				>
			</h1>

			<p data-hero class="max-w-[60ch] text-base leading-relaxed text-muted">
				Reparamos, optimizamos y actualizamos tu tecnología. Soluciones
				reales para que nada te frene.
			</p>

			<div class="flex flex-wrap gap-3">
				<a
					data-hero
					href="https://wa.me/5493816222509"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex items-center gap-2 bg-lime px-5 py-3 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-ink uppercase transition-transform duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_28px_-10px_rgba(180,255,57,0.55)]"
				>
					Consultar por WhatsApp
					<span
						aria-hidden="true"
						class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						>↗</span
					>
				</a>
				<a
					data-hero
					href="#servicios"
					class="group inline-flex items-center gap-2 border border-line px-5 py-3 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-text uppercase transition-transform duration-300 hover:-translate-y-0.5 hover:border-lime hover:shadow-[0_12px_28px_-14px_rgba(180,255,57,0.35)]"
				>
					Explorar servicios
					<span
						aria-hidden="true"
						class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						>↗</span
					>
				</a>
			</div>

			<p data-hero class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase">
				CONSULTA SIN COMPROMISO
			</p>
		</div>
	</div>

	<div
		class="relative aspect-[4/3] w-full md:absolute md:inset-y-0 md:right-0 md:aspect-auto md:w-1/2"
	>
		<div
			class="cpu-glow pointer-events-none absolute top-1/2 left-1/2 h-[85%] w-[85%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(180,255,57,0.2),transparent_65%)] blur-2xl"
			aria-hidden="true"
		>
		</div>

		<div class="relative z-10 h-full" data-cpu-parallax>
			<div class="cpu-float h-full">
				<img
					src={heroCpu.src}
					width={heroCpu.width}
					height={heroCpu.height}
					alt="Procesador montado en una motherboard con circuitos iluminados en verde"
					loading="eager"
					fetchpriority="high"
					class="cpu-image h-full w-full object-cover"
				/>
			</div>
		</div>
	</div>

	<div class="pointer-events-none absolute inset-x-0 bottom-6 z-20">
		<div class="container-page flex justify-end">
			<div
				data-hero-card
				class="pointer-events-auto w-72 border border-line bg-bg/85 p-6 backdrop-blur"
			>
				<p class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase">
					<span class="text-lime">●</span> BYTETEC / SYSTEM CARE
				</p>
				<p class="mt-2 text-xl leading-tight text-text">Volvé a estar al 100%.</p>
				<p class="mt-4 border-t border-line pt-3 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase">
					● REPARACIÓN · OPTIMIZACIÓN · SOPORTE
				</p>
			</div>
		</div>
	</div>

	<noscript>
		<style>
			[data-hero],
			[data-hero-card] {
				opacity: 1 !important;
			}
		</style>
	</noscript>
</section>

<script>
	import { animate, stagger } from "motion";

	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const items = Array.from(document.querySelectorAll("[data-hero]"));
	const card = document.querySelector("[data-hero-card]");
	const cpu = document.querySelector("[data-cpu-parallax]");

	if (reduced) {
		items.forEach((el) => {
			el.style.opacity = "1";
		});
		if (card) card.style.opacity = "1";
	} else {
		animate(
			items,
			{ opacity: [0, 1], y: [24, 0] },
			{ duration: 0.7, delay: stagger(0.09), ease: [0.22, 1, 0.36, 1] },
		);

		if (card) {
			animate(
				card,
				{ opacity: [0, 1], y: [32, 0] },
				{ duration: 0.8, delay: 0.95, ease: [0.22, 1, 0.36, 1] },
			);
		}
	}

	const canParallax = window.matchMedia(
		"(min-width: 768px) and (pointer: fine)",
	).matches;

	if (cpu && canParallax && !reduced) {
		window.addEventListener("mousemove", (event) => {
			const x = (event.clientX / window.innerWidth - 0.5) * 28;
			const y = (event.clientY / window.innerHeight - 0.5) * 28;
			animate(cpu, { x, y }, { duration: 0.6, ease: "easeOut" });
		});
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-hero],
		[data-hero-card] {
			opacity: 0;
		}
	}

	.caret {
		animation: caret-blink 1.1s steps(1, end) infinite;
	}

	.cpu-float {
		animation: cpu-float 6s ease-in-out infinite;
	}

	.cpu-image {
		-webkit-mask-image:
			linear-gradient(to right, transparent 0%, #000 35%),
			linear-gradient(to bottom, transparent 0%, #000 15%, #000 85%, transparent 100%);
		mask-image:
			linear-gradient(to right, transparent 0%, #000 35%),
			linear-gradient(to bottom, transparent 0%, #000 15%, #000 85%, transparent 100%);
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
	}

	.cpu-glow {
		animation: glow-pulse 4.5s ease-in-out infinite;
	}

	@media (max-width: 767px) {
		.cpu-image {
			-webkit-mask-image: linear-gradient(
				to bottom,
				transparent 0%,
				#000 15%,
				#000 85%,
				transparent 100%
			);
			mask-image: linear-gradient(
				to bottom,
				transparent 0%,
				#000 15%,
				#000 85%,
				transparent 100%
			);
		}
	}

	@keyframes caret-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@keyframes cpu-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-14px);
		}
	}

	@keyframes glow-pulse {
		0%,
		100% {
			opacity: 0.55;
			transform: translate(-50%, -50%) scale(1);
		}
		50% {
			opacity: 0.95;
			transform: translate(-50%, -50%) scale(1.06);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret,
		.cpu-float,
		.cpu-glow {
			animation: none;
		}
	}
</style>
