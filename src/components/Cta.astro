---
const whatsapp = "https://wa.me/5493816222509";
---

<section
	id="contacto"
	class="bg-lime text-ink"
	aria-labelledby="contacto-title"
>
	<div
		class="container-page grid gap-12 py-16 md:grid-cols-2 md:items-start md:py-24"
		data-reveal-group
	>
		<div class="flex flex-col gap-5">
			<p
				data-reveal
				class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-ink/70 uppercase"
			>
				¿LISTO PARA VOLVER AL 100%?
			</p>
			<h2
				id="contacto-title"
				data-reveal="mask"
				class="font-display text-6xl leading-[0.85] italic uppercase md:text-7xl"
			>
				<span class="block overflow-hidden">
					<span class="block leading-[0.95]">QUE NADA</span>
				</span>
				<span class="block overflow-hidden">
					<span class="block leading-[0.95]">TE FRENE.</span>
				</span>
			</h2>
			<p
				data-reveal
				class="mt-6 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-ink/70 uppercase md:mt-10"
			>
				HARDWARE · SOFTWARE · SOLUCIONES
			</p>
		</div>

		<div class="flex flex-col gap-5">
			<p data-reveal class="max-w-[60ch] text-lg leading-snug text-ink">
				Tu próxima solución empieza con un mensaje.
			</p>
			<a
				data-reveal
				href={whatsapp}
				target="_blank"
				rel="noopener noreferrer"
				class="group flex items-center justify-between gap-6 bg-ink px-6 py-4 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-text uppercase transition-transform duration-300 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-12px_rgba(10,16,12,0.6)]"
			>
				Escribir por WhatsApp
				<span
					aria-hidden="true"
					class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					>↗</span
				>
			</a>
			<p
				data-reveal
				class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-ink/70 uppercase"
			>
				ATENCIÓN PERSONALIZADA · SIN VUELTAS.
			</p>
		</div>
	</div>
</section>

<script>
	import "../scripts/reveal";
</script>
