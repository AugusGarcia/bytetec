---
const whatsapp = "https://wa.me/5493816222509";

const tags = ["OFFICE", "SISTEMAS", "OPTIMIZACIÓN"];

const steps = [
	{ number: "01", label: "Nos contás qué necesitás" },
	{ number: "02", label: "Coordinamos la conexión" },
	{ number: "03", label: "Resolvemos con vos" },
];
---

<section
	id="a-distancia"
	class="border-y border-line bg-surface-alt"
	aria-labelledby="distancia-title"
>
	<div
		class="container-page grid gap-12 py-10 md:grid-cols-2 md:items-start md:py-16"
		data-reveal-group
	>
		<div class="flex flex-col gap-5">
			<p
				data-reveal
				class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase"
			>
				02 / CONTACTOS · SOLUCIONES
			</p>
			<h2
				id="distancia-title"
				data-reveal="mask"
				class="font-display text-5xl leading-[0.9] italic uppercase"
			>
				<span class="block overflow-hidden">
					<span class="block leading-[0.95]">A DISTANCIA.</span>
				</span>
				<span class="block overflow-hidden">
					<span class="block leading-[0.95]">DE TU LADO.</span>
				</span>
			</h2>
			<p data-reveal class="max-w-[60ch] text-base leading-relaxed text-muted">
				Soporte 100% remoto para resolver problemas de software sin moverte
				de tu casa. Rápido y seguro.
			</p>
			<div
				data-reveal
				class="flex flex-wrap gap-2 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase"
			>
				{
					tags.map((tag) => (
						<span
							class="border border-line px-3 py-1 transition-colors duration-300 hover:border-lime hover:bg-lime/10 hover:text-lime"
						>
							{tag}
						</span>
					))
				}
			</div>
			<a
				data-reveal
				href={whatsapp}
				target="_blank"
				rel="noopener noreferrer"
				class="group inline-flex w-fit items-center gap-2 bg-lime px-5 py-3 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-ink uppercase transition-transform duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_28px_-10px_rgba(180,255,57,0.55)]"
			>
				Consultar soporte remoto
				<span
					aria-hidden="true"
					class="inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					>↗</span
				>
			</a>
		</div>

		<div data-reveal class="border border-line bg-surface">
			<div
				class="flex items-center justify-between gap-4 px-6 py-4 font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase"
			>
				<span><span class="text-lime">●</span> BYTETEC / REMOTO · SUPPORT</span>
				<span
					class="status-dot h-2 w-2 shrink-0 rounded-full bg-lime"
					aria-hidden="true"></span>
			</div>

			<div class="px-6 pb-6">
				<p class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint uppercase">
					{"{ CONEXIÓN SEGURA }"}
				</p>
				<h3 class="mt-4 text-2xl leading-tight text-text">
					Cerca, incluso a distancia.
				</h3>
				<ul class="mt-6 flex flex-col" data-reveal="list">
					{
						steps.map((step) => (
							<li class="flex items-baseline gap-4 border-t border-line py-3">
								<span class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-faint">
									{step.number}
								</span>
								<span class="text-sm text-text">{step.label}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<script>
	import "../scripts/reveal";
</script>

<style>
	.status-dot {
		animation: status-pulse 2.4s ease-in-out infinite;
	}

	@keyframes status-pulse {
		0%,
		100% {
			opacity: 0.35;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.status-dot {
			animation: none;
			opacity: 1;
		}
	}
</style>
