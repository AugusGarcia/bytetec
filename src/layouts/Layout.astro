---
import "../styles/global.css";
import powerIcon from "../assets/power-icon.png";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "BYTETEC",
	description = "Reparamos, optimizamos y actualizamos tu tecnología. Soluciones reales para que nada te frene.",
} = Astro.props;

const canonical = Astro.site ?? new URL("https://bytetec.vercel.app");
const ogImage = new URL("/og.jpg", canonical).href;
const ogUrl = new URL(Astro.url.pathname, canonical).href;
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0A100C" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BYTETEC" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Procesador sobre una motherboard con circuitos iluminados en verde" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/png" href={powerIcon.src} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-bg font-sans text-text">
		<slot />
	</body>
</html>
